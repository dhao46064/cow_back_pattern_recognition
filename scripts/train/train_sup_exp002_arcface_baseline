def main():
    parser = build_argument_parser()
    args = parser.parse_args()

    validate_arguments(args)

    # 日志和checkpoint严格使用固定根目录。
    (
        logger,
        log_run_dir,
        output_run_dir,
        run_name,
    ) = create_training_run(
        log_root=str(LOG_ROOT),
        output_root=str(OUTPUT_ROOT),
        exp_name=args.exp_name,
    )

    try:
        set_seed(args.seed)
        random.seed(args.seed)
        np.random.seed(args.seed)
        torch.manual_seed(args.seed)

        requested_device = str(
            args.device
        )

        if (
            requested_device.startswith("cuda")
            and not torch.cuda.is_available()
        ):
            logger.warning(
                "CUDA不可用，自动切换到CPU。"
            )

            device = torch.device(
                "cpu"
            )
        else:
            device = torch.device(
                requested_device
            )

        data_root = Path(
            args.obb_root
        )

        mask_root = Path(
            args.red_mask_root
        )

        if not data_root.exists():
            raise FileNotFoundError(
                f"训练数据集不存在：{data_root}"
            )

        if (
            args.red_aug_prob > 0
            and not mask_root.exists()
        ):
            raise FileNotFoundError(
                f"红色增强mask目录不存在：{mask_root}"
            )

        train_samples = get_samples(
            args.obb_root,
            "seen_train",
        )

        val_samples = get_samples(
            args.obb_root,
            "seen_val",
        )

        if len(train_samples) == 0:
            raise RuntimeError(
                "seen_train为空。"
            )

        if len(val_samples) == 0:
            raise RuntimeError(
                "seen_val为空。"
            )

        train_transform = build_transforms(
            train=args.train_augment
        )

        val_transform = build_transforms(
            train=False
        )

        train_cow_ids = sorted(
            set(
                str(sample["cow_id"])
                for sample in train_samples
            )
        )

        id2label = {
            cow_id: index
            for index, cow_id in enumerate(
                train_cow_ids
            )
        }

        num_train_classes = len(
            id2label
        )

        red_augment = CowBackRedColorShift(
            image_root=args.obb_root,
            mask_root=args.red_mask_root,
            probability=args.red_aug_prob,
            strengths=args.red_strengths,
            strength_probs=(
                args.red_strength_probs
            ),
            r_target=args.red_r_target,
            g_target=args.red_g_target,
            b_target=args.red_b_target,
            missing_mask_policy=(
                args.missing_mask_policy
            ),
        )

        if (
            args.red_aug_prob > 0
            and args.validate_red_masks
        ):
            logger.info(
                "开始检查seen_train对应mask。"
            )

            missing_masks = (
                red_augment.find_missing_masks(
                    sample["path"]
                    for sample in train_samples
                )
            )

            if missing_masks:
                preview = "\n".join(
                    (
                        f"image={record['image_path']} | "
                        f"mask={record['mask_path']}"
                    )
                    for record in missing_masks[:20]
                )

                raise FileNotFoundError(
                    f"共有{len(missing_masks)}张训练图片"
                    "缺少对应mask。\n"
                    f"前20条：\n{preview}"
                )

            logger.info(
                "seen_train对应mask检查通过。"
            )

        train_dataset = CowTrainDatasetNormal(
            samples=train_samples,
            transform=train_transform,
            id2label=id2label,
            red_augment=red_augment,
        )

        val_dataset = CowValDatasetFromSplit(
            samples=val_samples,
            id2label=id2label,
            transform=val_transform,
        )

        loader_generator = torch.Generator()
        loader_generator.manual_seed(
            args.seed
        )

        pin_memory = (
            device.type == "cuda"
        )

        train_loader = DataLoader(
            train_dataset,
            batch_size=args.batch_size,
            shuffle=True,
            num_workers=args.num_workers,
            pin_memory=pin_memory,
            worker_init_fn=seed_worker,
            generator=loader_generator,
            persistent_workers=(
                args.num_workers > 0
            ),
        )

        val_loader = DataLoader(
            val_dataset,
            batch_size=args.val_batch_size,
            shuffle=False,
            num_workers=args.num_workers,
            pin_memory=pin_memory,
            worker_init_fn=seed_worker,
            persistent_workers=(
                args.num_workers > 0
            ),
        )

        if (
            args.red_aug_prob > 0
            and args.num_workers > 0
        ):
            logger.warning(
                "num_workers>0时红色增强本身正常工作，"
                "但Trainer从主进程读取的每轮增强计数"
                "不会包含各worker内部完整统计。"
            )

        model = ArcFaceCowModel(
            num_classes=num_train_classes,
            embedding_dim=args.embedding_dim,
            s=args.arc_s,
            m=args.arc_m,
            pretrained=args.pretrained,
            freeze_backbone=(
                args.freeze_backbone
            ),
            hidden_dims=tuple(
                args.hidden_dims
            ),
            dropout=args.dropout,
            use_gem=args.use_gem,
            gem_p=args.gem_p,
            gem_learn_p=(
                args.gem_learn_p
            ),
        )

        optimizer = optim.AdamW(
            model.parameters(),
            lr=args.lr,
            weight_decay=args.wd,
        )

        start_epoch = 1
        resume_checkpoint = None

        if args.resume:
            (
                model,
                optimizer,
                start_epoch,
                resume_checkpoint,
            ) = load_checkpoint(
                model=model,
                optimizer=optimizer,
                checkpoint_path=args.resume,
                device=device,
                logger=logger,
                resume_only_model=(
                    args.resume_only_model
                ),
            )

        total_parameters = sum(
            parameter.numel()
            for parameter in model.parameters()
        )

        trainable_parameters = sum(
            parameter.numel()
            for parameter in model.parameters()
            if parameter.requires_grad
        )

        save_training_config(
            logger=logger,
            log_run_dir=log_run_dir,
            args=args,
            model_config={
                "model_class": (
                    model.__class__.__name__
                ),
                "num_classes": (
                    num_train_classes
                ),
                "embedding_dim": (
                    args.embedding_dim
                ),
                "hidden_dims": (
                    args.hidden_dims
                ),
                "dropout": args.dropout,
                "pretrained": args.pretrained,
                "freeze_backbone": (
                    args.freeze_backbone
                ),
                "pooling": (
                    "GeM"
                    if args.use_gem
                    else "GAP"
                ),
                "use_gem": args.use_gem,
                "gem_p_initial": (
                    args.gem_p
                ),
                "gem_learn_p": (
                    args.gem_learn_p
                ),
                "arc_s": args.arc_s,
                "arc_m": args.arc_m,
                "total_parameters": (
                    total_parameters
                ),
                "trainable_parameters": (
                    trainable_parameters
                ),
            },
            data_config={
                "dataset_root": str(
                    data_root
                ),
                "split_json": str(
                    data_root / "split.json"
                ),
                "train_samples": len(
                    train_samples
                ),
                "val_samples": len(
                    val_samples
                ),
                "train_cow_count": len(
                    train_cow_ids
                ),
                "train_dataset_class": (
                    train_dataset
                    .__class__
                    .__name__
                ),
                "val_dataset_class": (
                    val_dataset
                    .__class__
                    .__name__
                ),
                "train_transform": repr(
                    train_transform
                ),
                "val_transform": repr(
                    val_transform
                ),
                "batch_size": (
                    args.batch_size
                ),
                "val_batch_size": (
                    args.val_batch_size
                ),
                "num_workers": (
                    args.num_workers
                ),
                "pin_memory": (
                    pin_memory
                ),
            },
            augmentation_config={
                "ordinary_train_augment": (
                    args.train_augment
                ),
                "red_augmentation_enabled": (
                    args.red_aug_prob > 0
                ),
                **red_augment.get_config(),
                "validate_red_masks": (
                    args.validate_red_masks
                ),
            },
            optimizer_config={
                "optimizer_class": (
                    optimizer
                    .__class__
                    .__name__
                ),
                "learning_rate": (
                    args.lr
                ),
                "weight_decay": (
                    args.wd
                ),
            },
            trainer_config={
                "trainer_class": (
                    ArcFaceTrainer.__name__
                ),
                "epochs": args.epochs,
                "start_epoch": (
                    start_epoch
                ),
                "seed": args.seed,
                "device": str(device),
                "return_theta": (
                    args.return_theta
                ),
                "lambda_intra": (
                    args.lambda_intra
                ),
                "acc_eps": (
                    args.acc_eps
                ),
                "same_eps": (
                    args.same_eps
                ),
                "max_pairs_per_class": (
                    args.max_pairs_per_class
                ),
                "save_every_epoch": (
                    args.save_every_epoch
                ),
            },
            resume_config={
                "resume_enabled": bool(
                    args.resume
                ),
                "resume_path": args.resume,
                "resume_only_model": (
                    args.resume_only_model
                ),
                "resume_checkpoint_loaded": (
                    resume_checkpoint
                    is not None
                ),
            },
            extra_config={
                "run_name": run_name,
                "log_root": str(
                    LOG_ROOT
                ),
                "log_run_dir": str(
                    log_run_dir
                ),
                "output_root": str(
                    OUTPUT_ROOT
                ),
                "output_run_dir": str(
                    output_run_dir
                ),
            },
        )

        trainer = ArcFaceTrainer(
            model=model,
            train_loader=train_loader,
            val_loader=val_loader,
            optimizer=optimizer,
            device=device,
            logger=logger,
            log_run_dir=log_run_dir,
            output_run_dir=(
                output_run_dir
            ),
            run_name=run_name,
            seed=args.seed,
            return_theta=(
                args.return_theta
            ),
            lambda_intra=(
                args.lambda_intra
            ),
            acc_eps=args.acc_eps,
            same_eps=args.same_eps,
            max_pairs_per_class=(
                args.max_pairs_per_class
            ),
            save_every_epoch=(
                args.save_every_epoch
            ),
        )

        if resume_checkpoint is not None:
            trainer.load_state_from_ckpt(
                resume_checkpoint
            )

        logger.info(
            "开始执行ArcFace训练。"
        )

        trainer.fit(
            epochs=args.epochs,
            start_epoch=start_epoch,
        )

        logger.info(
            "训练正常完成。"
        )

    except KeyboardInterrupt:
        logger.warning(
            "训练被用户手动中断。"
        )
        raise

    except Exception:
        logger.exception(
            "训练过程中发生异常。"
        )
        raise

    finally:
        logger.info(
            f"本次日志目录：{log_run_dir}"
        )

        logger.info(
            f"本次输出目录：{output_run_dir}"
        )

        close_training_logger(
            logger
        )


if __name__ == "__main__":
    main()
