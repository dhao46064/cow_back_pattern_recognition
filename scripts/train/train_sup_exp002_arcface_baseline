def seed_worker(worker_id):
    """
    保证DataLoader worker中的numpy与random可复现。
    """
    worker_seed = (
        torch.initial_seed()
        % 2**32
    )

    np.random.seed(worker_seed)
    random.seed(worker_seed)


def validate_arguments(args):
    if not 0.0 <= args.red_aug_prob <= 1.0:
        raise ValueError(
            "red_aug_prob必须位于[0, 1]。"
        )

    if len(args.red_strengths) != len(
        args.red_strength_probs
    ):
        raise ValueError(
            "red_strengths与red_strength_probs"
            "长度必须一致。"
        )

    if args.epochs <= 0:
        raise ValueError(
            "epochs必须大于0。"
        )

    if args.batch_size <= 0:
        raise ValueError(
            "batch_size必须大于0。"
        )

    if args.val_batch_size <= 0:
        raise ValueError(
            "val_batch_size必须大于0。"
        )


def load_checkpoint(
    model,
    optimizer,
    checkpoint_path: str,
    device,
    logger,
    resume_only_model: bool = False,
):
    """
    加载模型或完整训练状态。
    """
    if not checkpoint_path:
        return (
            model,
            optimizer,
            1,
            None,
        )

    checkpoint_file = Path(
        checkpoint_path
    )

    if not checkpoint_file.exists():
        raise FileNotFoundError(
            f"Checkpoint不存在：{checkpoint_file}"
        )

    logger.info(
        f"Loading checkpoint: "
        f"{checkpoint_file}"
    )

    checkpoint = torch.load(
        checkpoint_file,
        map_location=device,
    )

    if (
        isinstance(checkpoint, dict)
        and "model" in checkpoint
    ):
        model.load_state_dict(
            checkpoint["model"],
            strict=True,
        )

    elif (
        isinstance(checkpoint, dict)
        and "model_state_dict" in checkpoint
    ):
        model.load_state_dict(
            checkpoint["model_state_dict"],
            strict=True,
        )

    else:
        model.load_state_dict(
            checkpoint,
            strict=True,
        )

    optimizer_restored = False

    if (
        not resume_only_model
        and isinstance(checkpoint, dict)
        and "optimizer" in checkpoint
    ):
        optimizer.load_state_dict(
            checkpoint["optimizer"]
        )

        optimizer_restored = True

    if isinstance(checkpoint, dict):
        start_epoch = int(
            checkpoint.get(
                "epoch",
                0,
            )
        ) + 1
    else:
        start_epoch = 1

    logger.info(
        "Checkpoint loaded | "
        f"start_epoch={start_epoch} | "
        f"optimizer_restored="
        f"{optimizer_restored}"
    )

    return (
        model,
        optimizer,
        start_epoch,
        checkpoint,
    )


def build_argument_parser():
    parser = argparse.ArgumentParser(
        description=(
            "ArcFace cow-back recognition "
            "training with online red augmentation"
        )
    )

    # =====================================================
    # 实验
    # =====================================================
    parser.add_argument(
        "--exp_name",
        type=str,
        default="arcface_redaug_p00",
    )

    # =====================================================
    # 数据
    # =====================================================
    parser.add_argument(
        "--obb_root",
        type=str,
        default=str(DEFAULT_DATA_ROOT),
    )

    parser.add_argument(
        "--red_mask_root",
        type=str,
        default=str(DEFAULT_MASK_ROOT),
    )

    parser.add_argument(
        "--train_augment",
        action=argparse.BooleanOptionalAction,
        default=False,
        help=(
            "是否启用build_transforms(train=True)"
            "中的普通训练增强。"
        ),
    )

    parser.add_argument(
        "--batch_size",
        type=int,
        default=64,
    )

    parser.add_argument(
        "--val_batch_size",
        type=int,
        default=32,
    )

    parser.add_argument(
        "--num_workers",
        type=int,
        default=4,
    )

    # =====================================================
    # 在线红色增强
    # =====================================================
    parser.add_argument(
        "--red_aug_prob",
        type=float,
        default=0.2,
    )

    parser.add_argument(
        "--red_strengths",
        type=float,
        nargs="+",
        default=[
            0.4,
            0.6,
            0.8,
            1.0,
        ],
    )

    parser.add_argument(
        "--red_strength_probs",
        type=float,
        nargs="+",
        default=[
            0.35,
            0.35,
            0.20,
            0.10,
        ],
    )

    parser.add_argument(
        "--red_r_target",
        type=float,
        default=0.78,
    )

    parser.add_argument(
        "--red_g_target",
        type=float,
        default=0.55,
    )

    parser.add_argument(
        "--red_b_target",
        type=float,
        default=0.50,
    )

    parser.add_argument(
        "--missing_mask_policy",
        type=str,
        choices=[
            "error",
            "original",
        ],
        default="error",
    )

    parser.add_argument(
        "--validate_red_masks",
        action=argparse.BooleanOptionalAction,
        default=True,
    )

    # =====================================================
    # 训练
    # =====================================================
    parser.add_argument(
        "--epochs",
        type=int,
        default=50,
    )

    parser.add_argument(
        "--seed",
        type=int,
        default=42,
    )

    parser.add_argument(
        "--device",
        type=str,
        default="cuda",
    )

    parser.add_argument(
        "--save_every_epoch",
        action=argparse.BooleanOptionalAction,
        default=True,
    )

    # =====================================================
    # 恢复训练
    # =====================================================
    parser.add_argument(
        "--resume",
        type=str,
        default="",
    )

    parser.add_argument(
        "--resume_only_model",
        action=argparse.BooleanOptionalAction,
        default=False,
    )

    # =====================================================
    # 模型
    # =====================================================
    parser.add_argument(
        "--embedding_dim",
        type=int,
        default=128,
    )

    parser.add_argument(
        "--hidden_dims",
        type=int,
        nargs="+",
        default=[
            1024,
            128,
        ],
    )

    parser.add_argument(
        "--dropout",
        type=float,
        default=0.3,
    )

    parser.add_argument(
        "--pretrained",
        action=argparse.BooleanOptionalAction,
        default=True,
    )

    parser.add_argument(
        "--freeze_backbone",
        action=argparse.BooleanOptionalAction,
